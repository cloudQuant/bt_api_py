+            if command == ("close",):
+                deployment.close()
+                control.send(
+                    (
+                        "closed",
+                        deployment.state,
+                        provider.connect_calls,
+                        provider.read_calls,
+                        provider.close_calls,
+                        secret_resolution_calls,
