+def _authority_facts(path: str, account_ref: str) -> tuple[dict[str, Any], tuple[dict[str, Any], ...]]:
+    with sqlite3.connect(path) as connection:
+        connection.row_factory = sqlite3.Row
+        rows = connection.execute(
+            "SELECT * FROM execution_group_coordinators WHERE account_ref=? AND strategy_id=?",
+            (account_ref, _STRATEGY),
+        ).fetchall()
+        hold_rows = connection.execute(
+            "SELECT hold_json FROM group_dispatch_holds ORDER BY hold_id"
+        ).fetchall()
+    assert len(rows) == 1, (account_ref, len(rows))
+    return dict(rows[0]), tuple(json.loads(row["hold_json"]) for row in hold_rows)
