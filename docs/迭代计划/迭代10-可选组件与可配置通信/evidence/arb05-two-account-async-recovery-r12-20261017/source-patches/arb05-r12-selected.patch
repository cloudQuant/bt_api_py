+def _execution_record(
+    account_paths: dict[str, dict[str, str]], request: dict[str, Any], account_ref: str
+) -> Any:
+    execution = arb02.SqliteExecutionStore(account_paths[account_ref]["execution"])
+    try:
+        leg = next(leg for leg in request["legs"] if leg["account_ref"] == account_ref)
+        intent_id = arb02.group_leg_intent_id(request["group_id"], leg["leg_id"])
+        return execution.get(intent_id, scope=arb02._execution_scope(account_ref, _STRATEGY))
+    finally:
+        execution.close()
