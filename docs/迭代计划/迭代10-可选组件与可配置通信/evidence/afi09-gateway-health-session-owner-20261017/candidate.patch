+                control.send(
+                    (
+                        "status",
+                        provider.connect_calls,
+                        provider.read_calls,
+                        provider.close_calls,
+                        secret_resolution_calls,
+                        provider_factory_calls,
+                        session_owner.claimed_session_count,
+                        status["ready"],
