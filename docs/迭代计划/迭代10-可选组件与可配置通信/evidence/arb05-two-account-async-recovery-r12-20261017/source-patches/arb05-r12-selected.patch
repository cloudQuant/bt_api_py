+def _start_account_owner(
+    context: Any,
+    *,
+    account_ref: str,
+    raw_config: dict[str, Any],
+    registry_path: str,
+    paths: dict[str, str],
+    endpoint: str,
+    server_keys: tuple[bytes, bytes],
+    coordinator_client_public: bytes,
+    metadata_reference_ns: int,
+    provider_entered: Any,
+    provider_release: Any,
+    reservation_events: Any,
+    reservation_committed: Any | None = None,
+    reservation_reply_entered: Any | None = None,
+    reservation_reply_release: Any | None = None,
+) -> tuple[Any, Any]:
+    parent_control, child_control = context.Pipe(duplex=True)
+    process = None
+    process_started = False
+    child_control_open = True
+    try:
+        process = context.Process(
+            name=f"arb05-account-owner-{account_ref}",
+            target=arb02._account_host_process,
+            args=(
+                child_control,
+                raw_config,
+                registry_path,
+                paths,
+                account_ref,
+                server_keys[0],
+                server_keys[1],
+                coordinator_client_public,
+                metadata_reference_ns,
+                ("filled",),
+                provider_entered,
+                provider_release,
+                _GROUP_ID if reservation_committed is not None else None,
+                reservation_committed,
+                reservation_reply_entered,
+                reservation_reply_release,
+                reservation_events,
+            ),
+        )
+        process.start()
+        process_started = True
+        child_control.close()
+        child_control_open = False
+        ready = arb02._receive(parent_control)
+        assert ready == ("ready", endpoint)
+        return process, parent_control
+    except BaseException as startup_error:
+        cleanup_error = _cleanup_failed_account_owner_start(
+            process,
+            parent_control,
+            child_control,
+            process_started=process_started,
+            child_control_open=child_control_open,
+            account_ref=account_ref,
+        )
+        if cleanup_error is not None:
+            add_note = getattr(startup_error, "add_note", None)
+            if callable(add_note):
+                add_note(f"account Host startup cleanup failed: {type(cleanup_error).__name__}")
+        raise
+
+
+def _cleanup_failed_account_owner_start(
+    process: Any | None,
+    parent_control: Any,
+    child_control: Any,
+    *,
+    process_started: bool,
+    child_control_open: bool,
+    account_ref: str,
+) -> BaseException | None:
+    """Stop a failed test-owned owner start without closing live child handles."""
+
+    started = process_started
+    if process is None:
+        started = False
+    elif not started:
+        try:
+            started = process.pid is not None
+        except BaseException:
+            started = True
+
+    controls = (parent_control, child_control) if child_control_open else (parent_control,)
+    if not started:
+        failures: list[BaseException] = []
+        if process is not None:
+            try:
+                process.close()
+            except BaseException as error:
+                failures.append(error)
+        for control in controls:
+            try:
+                control.close()
+            except BaseException as error:
+                failures.append(error)
+        return failures[0] if failures else None
+
+    try:
+        alive = bool(process.is_alive())
+    except BaseException as error:
+        _retain_unconfirmed_child(
+            f"account-{account_ref} failed startup", process, controls
+        )
+        failure = RuntimeError(
+            f"account-{account_ref} startup cleanup could not confirm child exit"
+        )
+        failure.__cause__ = error
+        return failure
+
+    if alive:
+        # A ready Host can still follow its normal close protocol.  If startup
+        # never reaches ready, the bounded wait falls through to terminate/kill.
+        startup_deadline = time.monotonic() + 2.0
+        ready = False
+        while time.monotonic() < startup_deadline:
+            message = _receive_owned_host_message(
+                parent_control,
+                process,
+                startup_deadline,
+                f"account-{account_ref} failed-start readiness",
+            )
+            if message is None:
+                break
+            if isinstance(message, tuple) and message and message[0] == "ready":
+                ready = True
+                break
+            if isinstance(message, tuple) and message and message[0] == "error":
+                break
+
+        if ready:
+            exited, stop_error = _stop_owned_host_process(
+                process,
+                parent_control,
+                phase=f"account-{account_ref} failed-start normal close",
+                normal_timeout=2.0,
+                terminate_timeout=2.0,
+                kill_timeout=2.0,
+            )
+        else:
+            exited, stop_error = _stop_owned_host_process(
+                process,
+                parent_control,
+                phase=f"account-{account_ref} failed-start cleanup",
+                normal_timeout=0.5,
+                terminate_timeout=2.0,
+                kill_timeout=2.0,
+            )
+    else:
+        exited, stop_error = True, None
+        close_error = _close_confirmed_child_handles(
+            f"account-{account_ref} failed startup", process, (parent_control,)
+        )
+        if close_error is not None:
+            stop_error = close_error
+
+    if not exited:
+        _retain_unconfirmed_child(
+            f"account-{account_ref} failed startup", process, controls
+        )
+        return stop_error or RuntimeError(
+            f"account-{account_ref} failed-start child remains alive; handles retained"
+        )
+
+    if child_control_open:
+        try:
+            child_control.close()
+        except BaseException as error:
+            stop_error = stop_error or error
+    return stop_error
+
+
+def _start_initial_coordinator_with_owned_cleanup(*args: Any, **kwargs: Any) -> Any:
+    """Use the shared coordinator setup while retaining this test's child on failure."""
+
+    original_cleanup = arb02._cleanup_failed_host_start
+
+    def cleanup_failed_start(
+        process: Any | None,
+        parent_control: Any,
+        child_control: Any,
+        *,
+        process_started: bool,
+    ) -> BaseException | None:
+        child_control_open = not bool(getattr(child_control, "closed", False))
+        return _cleanup_failed_account_owner_start(
+            process,
+            parent_control,
+            child_control,
+            process_started=process_started,
+            child_control_open=child_control_open,
+            account_ref="group-coordinator",
+        )
+
+    arb02._cleanup_failed_host_start = cleanup_failed_start
+    try:
+        return arb02._start_coordinator(*args, **kwargs)
+    finally:
+        arb02._cleanup_failed_host_start = original_cleanup
+
+
+def _activate_order_session(
+    account_controls: dict[str, Any], bindings: tuple[Any, ...], account_ref: str
+) -> tuple[str, int]:
+    matches = tuple(
+        item
+        for item in bindings
+        if item[0] == "upstream.orders" and item[1] == account_ref and item[2] == _STRATEGY
+    )
+    assert len(matches) == 1, (account_ref, matches)
+    mount, _, strategy_ref, _scope_ref, registration_id, operations = matches[0]
+    assert mount == "upstream.orders"
+    assert operations == tuple(sorted({"orders.submit_group_leg", "orders.resolve_group_leg"}))
+    control = account_controls[account_ref]
+    control.send(("activate", registration_id))
+    activated = arb02._receive(control)
+    assert activated[0:2] == ("activated", registration_id), activated
+    assert activated[3] == strategy_ref
+    assert type(activated[2]) is int and activated[2] > 0
+    return registration_id, activated[2]
+
+
+def _assert_no_child_records(
+    account_paths: dict[str, dict[str, str]], request: dict[str, Any]
+) -> None:
+    for account_ref, leg in zip(arb02._ACCOUNTS, request["legs"], strict=True):
+        execution = arb02.SqliteExecutionStore(account_paths[account_ref]["execution"])
+        try:
+            intent_id = arb02.group_leg_intent_id(request["group_id"], leg["leg_id"])
+            assert execution.get(
+                intent_id,
+                scope=arb02._execution_scope(account_ref, _STRATEGY),
+            ) is None
+        finally:
+            execution.close()
+
