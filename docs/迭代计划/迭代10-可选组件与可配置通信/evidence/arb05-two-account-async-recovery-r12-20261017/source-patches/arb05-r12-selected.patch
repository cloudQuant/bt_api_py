+def _cleanup_failed_coordinator_barrier_start(
+    process: Any | None,
+    parent_control: Any,
+    child_control: Any,
+    startup_recovery_release: Any,
+    freeze_owner_recovery: Any,
+    *,
+    process_started: bool,
+    child_control_open: bool,
+    observed: list[tuple[Any, ...]],
+) -> BaseException | None:
+    """Release the startup barrier before closing only its test-owned child."""
+
+    failure: BaseException | None = None
+    try:
+        freeze_owner_recovery.set()
+        startup_recovery_release.set()
+    except BaseException as error:
+        failure = error
+    started = process_started
+    if process is None:
+        started = False
+    elif not started:
+        try:
+            started = process.pid is not None
+        except BaseException:
+            started = True
+
+    if not started:
+        if process is not None:
+            try:
+                process.close()
+            except BaseException as error:
+                failure = failure or error
+        for endpoint in (parent_control, child_control if child_control_open else None):
+            if endpoint is not None:
+                try:
+                    endpoint.close()
+                except BaseException as error:
+                    failure = failure or error
+        return failure
+
+    ready = False
+    try:
+        deadline = time.monotonic() + 8.0
+        messages_seen = 0
+        while not ready:
+            message = _receive_coordinator_control(
+                parent_control, process, deadline, "failed-start cleanup readiness"
+            )
+            if message is None:
+                continue
+            messages_seen += 1
+            if messages_seen > _MAX_COORDINATOR_CONTROL_MESSAGES_PER_PHASE:
+                raise AssertionError("coordinator cleanup readiness message budget exceeded")
+            observed.append(message)
+            if message[0] == "ready":
+                ready = True
+                break
+            if message[0] == "error":
+                break
+
+        if ready:
+            if not process.is_alive():
+                raise AssertionError("coordinator exited before failed-start close request")
+            parent_control.send("close")
+            close_deadline = time.monotonic() + 5.0
+            closed = False
+            messages_seen = 0
+            while not closed:
+                message = _receive_coordinator_control(
+                    parent_control, process, close_deadline, "failed-start cleanup close"
+                )
+                if message is None:
+                    continue
+                messages_seen += 1
+                if messages_seen > _MAX_COORDINATOR_CONTROL_MESSAGES_PER_PHASE:
+                    raise AssertionError("coordinator cleanup close message budget exceeded")
+                observed.append(message)
+                if message[0] == "closed":
+                    closed = True
+                    break
+                if message[0] == "error":
+                    break
+            if not closed and process.is_alive():
+                failure = TimeoutError("coordinator did not acknowledge normal close")
+    except BaseException as error:
+        failure = failure or error
+    finally:
+        try:
+            alive = bool(process.is_alive())
+        except BaseException as error:
+            alive = True
+            failure = failure or RuntimeError(
+                "coordinator failed-start cleanup could not confirm child exit"
+            )
+            failure.__cause__ = error
+        if alive:
+            try:
+                process.terminate()
+            except BaseException as error:
+                failure = failure or error
+            try:
+                process.join(5)
+            except BaseException as error:
+                failure = failure or error
+            try:
+                alive = bool(process.is_alive())
+            except BaseException as error:
+                alive = True
+                failure = failure or error
+            if alive:
+                kill = getattr(process, "kill", None)
+                if callable(kill):
+                    try:
+                        kill()
+                    except BaseException as error:
+                        failure = failure or error
+                    try:
+                        process.join(5)
+                    except BaseException as error:
+                        failure = failure or error
+                try:
+                    alive = bool(process.is_alive())
+                except BaseException as error:
+                    alive = True
+                    failure = failure or error
+            if not alive:
+                failure = failure or RuntimeError(
+                    "test-owned coordinator required forced cleanup"
+                )
+        if alive:
+            controls = (parent_control, child_control) if child_control_open else (parent_control,)
+            _retain_unconfirmed_child(
+                "coordinator failed startup", process, controls
+            )
+            failure = failure or RuntimeError(
+                "coordinator failed-start child remains alive; controls retained"
+            )
+        else:
+            for endpoint in (parent_control, child_control if child_control_open else None):
+                if endpoint is not None:
+                    try:
+                        endpoint.close()
+                    except BaseException as error:
+                        failure = failure or error
+        try:
+            if not alive:
+                process.join(0)
+                process.close()
+        except BaseException as error:
+            failure = failure or error
+    return failure
+
+
+def _receive_coordinator_control(
+    control: Any,
+    process: Any,
+    deadline: float,
+    phase: str,
+) -> tuple[Any, ...] | None:
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        raise AssertionError(f"coordinator {phase} timed out")
+    if not control.poll(min(0.1, remaining)):
+        if process.is_alive():
+            return None
+        if not control.poll(0):
+            raise AssertionError(
+                f"coordinator exited during {phase}; exitcode={process.exitcode}"
+            )
+    try:
+        return control.recv()
+    except EOFError as error:
+        raise AssertionError(
+            f"coordinator control channel closed during {phase}; "
+            f"exitcode={process.exitcode}"
+        ) from error
+
+
+def _stop_traced_coordinator_process(
+    process: Any,
+    control: Any,
+    observed: list[tuple[Any, ...]],
+) -> None:
+    failures: list[str] = []
+    closed = False
+    messages_seen = 0
+    try:
+        if process.is_alive():
+            control.send("close")
+        deadline = time.monotonic() + 20
+        while not closed:
+            try:
+                message = _receive_coordinator_control(
+                    control, process, deadline, "normal close"
+                )
+            except AssertionError as error:
+                failures.append(str(error))
+                break
+            if message is None:
+                continue
+            messages_seen += 1
+            if messages_seen > _MAX_COORDINATOR_CONTROL_MESSAGES_PER_PHASE:
+                failures.append("coordinator normal-close message budget exceeded")
+                break
+            if message[0] == "rpc":
+                observed.append(message)
+                continue
+            if message[0] in {"ready", "recovery_frozen"}:
+                continue
+            if message[0] == "closed":
+                closed = True
+                continue
+            if message[0] == "error":
+                failures.append(f"coordinator close returned error: {message!r}")
+                break
+            failures.append(f"unexpected coordinator close message: {message!r}")
+
+        process.join(5)
+        if process.is_alive():
+            failures.append("coordinator remained alive after normal-close wait")
+            process.terminate()
+            process.join(5)
+            if process.is_alive():
+                kill = getattr(process, "kill", None)
+                if callable(kill):
+                    kill()
+                    process.join(5)
+            if process.is_alive():
+                failures.append("coordinator remained alive after forced cleanup")
+            else:
+                failures.append("coordinator required forced cleanup")
+        elif process.exitcode != 0:
+            failures.append(f"coordinator exited with code {process.exitcode}")
+        if not closed:
+            failures.append("coordinator did not acknowledge normal close")
+    except BaseException as error:
+        failures.append(f"coordinator cleanup raised {type(error).__name__}")
+        try:
+            if process.is_alive():
+                process.terminate()
+                process.join(5)
+                if process.is_alive():
+                    kill = getattr(process, "kill", None)
+                    if callable(kill):
+                        kill()
+                        process.join(5)
+                if process.is_alive():
+                    failures.append("coordinator remained alive after forced cleanup")
+                else:
+                    failures.append("coordinator required forced cleanup")
+        except BaseException as cleanup_error:
+            failures.append(f"coordinator forced cleanup raised {type(cleanup_error).__name__}")
+    finally:
+        try:
+            alive = bool(process.is_alive())
+        except BaseException as error:
+            alive = True
+            failures.append(
+                f"coordinator exit could not be confirmed: {type(error).__name__}"
+            )
+        if alive:
+            _retain_unconfirmed_child("coordinator normal close", process, (control,))
+            failures.append("coordinator remains alive; control and process retained")
+        else:
+            try:
+                control.close()
+            except BaseException as error:
+                failures.append(f"coordinator control close raised {type(error).__name__}")
+            try:
+                process.close()
+            except BaseException as error:
+                failures.append(f"coordinator process close raised {type(error).__name__}")
+    if failures:
+        raise AssertionError("; ".join(failures))
+
+
+def _validate_coordinator_bindings(bindings: tuple[Any, ...]) -> None:
+    expected_operations = {
+        "upstream.orders": tuple(
+            sorted({"orders.submit_group_leg", "orders.resolve_group_leg"})
+        ),
+        "upstream.order_query": ("orders.query_group_leg",),
+        "upstream.account_reservations": tuple(
+            sorted({"reservations.reserve", "reservations.query", "reservations.release"})
+        ),
+    }
+    expected = {
+        (mount, account, strategy, scope_ref)
+        for strategy in arb02._STRATEGIES
+        for account in arb02._ACCOUNTS
+        for mount, scope_ref in (
+            ("upstream.orders", arb02._route_refs(account, strategy)[1]),
+            ("upstream.order_query", arb02._route_refs(account, strategy)[2]),
+            ("upstream.account_reservations", arb02._route_refs(account, strategy)[0]),
+        )
+    }
+    assert len(bindings) == len(expected) == 12
+    assert {
+        (mount, account, strategy, scope_ref)
+        for mount, account, strategy, scope_ref, _registration_id, _operations in bindings
+    } == expected
+    assert all(registration_id for *_, registration_id, _operations in bindings)
+    assert all(
+        operations == expected_operations[mount]
+        for mount, _account, _strategy, _scope_ref, _registration_id, operations in bindings
+    )
+
