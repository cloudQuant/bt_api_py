+@pytest.mark.integration
+def test_two_account_recovery_fences_second_owner_until_its_generation_is_authorized(
+    tmp_path: Path,
+) -> None:
+    """A real B Host outage preserves the group until B's writer generation is authorized."""
+
+    metadata_reference_ns = time.time_ns()
+    account_paths = {
+        account: {
+            name: str(tmp_path / f"{account}-{name}.sqlite3")
+            for name in (
+                "registry",
+                "provider",
+                "execution",
+                "risk_order_journal",
+                "proof",
+                "risk_gate",
+                "accepted",
+                "group_authority",
