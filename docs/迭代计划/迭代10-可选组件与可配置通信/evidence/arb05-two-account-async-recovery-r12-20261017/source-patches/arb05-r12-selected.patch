+"""Two account owners recover in separate local process generations."""
+
+from __future__ import annotations
+
+import json
+import multiprocessing
+import queue
+import sqlite3
+import sys
+import time
+from pathlib import Path
+from typing import Any
+
+import pytest
+import zmq
+
+from bt_api_py.service_execution_group import GroupCoordinatorService
+from tests.integration import test_arb02_group_budget_service as arb02
+
+_GROUP_ID = "arb05-two-account-async-recovery"
+_STRATEGY = arb02._STRATEGIES[0]
+# One accepted group can trigger at most two reservation queries per one-second
+# owner-recovery tick; each traced RPC contributes a start and a terminal
+# control message.  The per-phase ceiling allows substantial headroom over the
+# bounded waits below while preventing an unbounded control-channel drain.
+_MAX_COORDINATOR_CONTROL_MESSAGES_PER_PHASE = 256
+_RETAINED_ARB05_CHILDREN: list[tuple[str, Any, tuple[Any, ...]]] = []
+
+
+def _retain_unconfirmed_child(
+    phase: str, process: Any, controls: tuple[Any, ...]
+) -> None:
+    """Keep test-owned process and control references if exit is not proven."""
+
+    for index, (existing_phase, existing_process, existing_controls) in enumerate(
+        _RETAINED_ARB05_CHILDREN
+    ):
+        if existing_process is process:
+            merged = existing_controls + tuple(
+                control
+                for control in controls
+                if all(control is not current for current in existing_controls)
+            )
+            _RETAINED_ARB05_CHILDREN[index] = (
+                f"{existing_phase}; {phase}",
+                process,
+                merged,
+            )
+            return
+    _RETAINED_ARB05_CHILDREN.append((phase, process, controls))
+
+
+def _forget_unconfirmed_child(process: Any) -> None:
+    _RETAINED_ARB05_CHILDREN[:] = [
+        item for item in _RETAINED_ARB05_CHILDREN if item[1] is not process
+    ]
+
+
+def _close_confirmed_child_handles(
+    phase: str, process: Any, controls: tuple[Any, ...]
+) -> BaseException | None:
+    """Close owned handles only after the child is known to have exited."""
+
+    try:
+        if process.is_alive():
+            _retain_unconfirmed_child(phase, process, controls)
+            return RuntimeError(f"{phase}: child is still alive; handles retained")
+    except BaseException as error:
+        _retain_unconfirmed_child(phase, process, controls)
+        failure = RuntimeError(
+            f"{phase}: child exit could not be confirmed; handles retained"
+        )
+        failure.__cause__ = error
+        return failure
+
+    failures: list[BaseException] = []
+    for control in controls:
+        try:
+            control.close()
+        except BaseException as error:
+            failures.append(error)
+    try:
+        process.close()
+    except BaseException as error:
+        failures.append(error)
+    if failures:
+        failure = RuntimeError(
+            f"{phase}: failed to close {len(failures)} stopped-child handle(s)"
+        )
+        failure.__cause__ = failures[0]
+        return failure
+    _forget_unconfirmed_child(process)
+    return None
+
+
+def _receive_owned_host_message(
+    control: Any, process: Any, deadline: float, phase: str
+) -> tuple[Any, ...] | None:
+    """Receive one message without treating a short poll interval as a timeout."""
+
+    while True:
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            return None
+        try:
+            if control.poll(min(0.1, remaining)):
+                return control.recv()
+        except EOFError:
+            return None
+        except (OSError, ValueError):
+            return None
+        try:
+            alive = process.is_alive()
+        except BaseException:
+            return None
+        if not alive:
+            try:
+                if control.poll(0):
+                    return control.recv()
+            except BaseException:
+                pass
+            return None
+
+
+def _stop_owned_host_process(
+    process: Any,
+    control: Any,
+    *,
+    phase: str,
+    normal_timeout: float = 20.0,
+    terminate_timeout: float = 5.0,
+    kill_timeout: float = 5.0,
+) -> tuple[bool, BaseException | None]:
+    """Boundedly close this test's Host, retaining handles unless exit is proven."""
+
+    failures: list[BaseException] = []
+    forced = False
+    started_at = time.monotonic()
+    try:
+        alive = bool(process.is_alive())
+    except BaseException as error:
+        _retain_unconfirmed_child(phase, process, (control,))
+        failure = RuntimeError(f"{phase}: cannot inspect child liveness")
+        failure.__cause__ = error
+        return False, failure
+
+    if not alive:
+        failure = RuntimeError(f"{phase}: child exited before normal close")
+        close_error = _close_confirmed_child_handles(phase, process, (control,))
+        if close_error is not None:
+            failure.__cause__ = close_error
+        return True, failure
+
+    if alive:
+        try:
+            control.send("close")
+        except BaseException as error:
+            failures.append(error)
+        else:
+            deadline = started_at + max(0.0, normal_timeout)
+            while True:
+                message = _receive_owned_host_message(control, process, deadline, phase)
+                if message is None:
+                    failures.append(TimeoutError(f"{phase}: normal close was not acknowledged"))
+                    break
+                if isinstance(message, tuple) and message and message[0] == "closed":
+                    break
+                if isinstance(message, tuple) and message and message[0] == "error":
+                    failures.append(RuntimeError(f"{phase}: child reported {message!r}"))
+                    break
+                failures.append(RuntimeError(f"{phase}: unexpected close response {message!r}"))
+                break
+        try:
+            remaining = max(0.0, started_at + max(0.0, normal_timeout) - time.monotonic())
+            process.join(remaining)
+        except BaseException as error:
+            failures.append(error)
+
+    try:
+        alive = bool(process.is_alive())
+    except BaseException as error:
+        _retain_unconfirmed_child(phase, process, (control,))
+        failures.append(RuntimeError(f"{phase}: child exit could not be confirmed"))
+        failures[-1].__cause__ = error
+        return False, failures[0]
+
+    if alive:
+        forced = True
+        try:
+            process.terminate()
+        except BaseException as error:
+            failures.append(error)
+        try:
+            process.join(max(0.0, terminate_timeout))
+        except BaseException as error:
+            failures.append(error)
+        try:
+            alive = bool(process.is_alive())
+        except BaseException as error:
+            alive = True
+            failures.append(error)
+
+    if alive:
+        forced = True
+        kill = getattr(process, "kill", None)
+        if callable(kill):
+            try:
+                kill()
+            except BaseException as error:
+                failures.append(error)
+            try:
+                process.join(max(0.0, kill_timeout))
+            except BaseException as error:
+                failures.append(error)
+        try:
+            alive = bool(process.is_alive())
+        except BaseException as error:
+            alive = True
+            failures.append(error)
+
+    if alive:
+        _retain_unconfirmed_child(phase, process, (control,))
+        failure = RuntimeError(f"{phase}: child remains alive; handles retained")
+        if failures:
+            failure.__cause__ = failures[0]
+        return False, failure
+
+    try:
+        exitcode = process.exitcode
+    except BaseException as error:
+        exitcode = None
+        failures.append(error)
+    close_error = _close_confirmed_child_handles(phase, process, (control,))
+    if close_error is not None:
+        failures.append(close_error)
+    if forced:
+        failure = RuntimeError(f"{phase}: normal close failed; forced cleanup was required")
+        if failures:
+            failure.__cause__ = failures[0]
+        return True, failure
+    elif exitcode != 0:
+        failures.append(RuntimeError(f"{phase}: child exited with code {exitcode!r}"))
+    return True, failures[0] if failures else None
+
+
+def _stop_registered_owner(
+    account_ref: str,
+    process: Any,
+    control: Any,
+    process_registry: dict[str, Any],
+    control_registry: dict[str, Any],
+) -> None:
+    exited, failure = _stop_owned_host_process(
+        process, control, phase=f"account-{account_ref} normal close"
+    )
+    if exited:
+        if process_registry.get(account_ref) is process:
+            process_registry.pop(account_ref)
+        if control_registry.get(account_ref) is control:
+            control_registry.pop(account_ref)
+    if failure is not None:
+        raise failure
+
+
+def _stop_owned_host_or_raise(process: Any, control: Any, *, phase: str) -> None:
+    _exited, failure = _stop_owned_host_process(process, control, phase=phase)
+    if failure is not None:
+        raise failure
+
+
+def _release_retained_owner_if_exited(account_ref: str) -> BaseException | None:
+    expected_name = f"arb05-account-owner-{account_ref}"
+    for phase, process, controls in tuple(_RETAINED_ARB05_CHILDREN):
+        if getattr(process, "name", None) != expected_name:
+            continue
+        try:
+            alive = bool(process.is_alive())
+        except BaseException as error:
+            failure = RuntimeError(
+                f"retained account-{account_ref} owner exit remains unconfirmed"
+            )
+            failure.__cause__ = error
+            return failure
+        if alive:
+            return RuntimeError(
+                f"retained account-{account_ref} owner is still alive; refusing a duplicate Host"
+            )
+        return _close_confirmed_child_handles(phase, process, controls)
+    return None
+
+
+def test_owned_host_stop_keeps_control_until_exit_and_continues_cleanup() -> None:
+    events: list[str] = []
+
+    class FakeProcess:
+        def __init__(self) -> None:
+            self.alive = True
+            self.exitcode = None
+            self.closed = False
+            self.control: FakeControl | None = None
+
+        def is_alive(self) -> bool:
+            return self.alive
+
+        def join(self, _timeout: float) -> None:
+            events.append("join")
+
+        def terminate(self) -> None:
+            assert self.alive
+            assert self.control is not None and not self.control.closed
+            events.append("terminate")
+
+        def kill(self) -> None:
+            assert self.alive
+            assert self.control is not None and not self.control.closed
+            events.append("kill")
+
+        def close(self) -> None:
+            assert not self.alive
+            events.append("process-close")
+            self.closed = True
+
+    class FakeControl:
+        def __init__(self, process: FakeProcess) -> None:
+            self.process = process
+            self.closed = False
+            process.control = self
+
+        def send(self, message: str) -> None:
+            assert message == "close"
+            assert self.process.alive and not self.closed
+            events.append("send-close")
+
+        def poll(self, _timeout: float) -> bool:
+            return False
+
+        def close(self) -> None:
+            assert not self.process.alive
+            events.append("control-close")
+            self.closed = True
+
+    process = FakeProcess()
+    control = FakeControl(process)
+    def stop_owned_child() -> None:
+        exited, failure = _stop_owned_host_process(
+            process,
+            control,
+            phase="fake bounded cleanup",
+            normal_timeout=0,
+            terminate_timeout=0,
+            kill_timeout=0,
+        )
+        assert not exited
+        assert failure is not None and "handles retained" in str(failure)
+        assert process.alive
+        assert not control.closed and not process.closed
+        raise failure
+
+    cleanup_error = arb02._attempt_cleanup(
+        (stop_owned_child, lambda: events.append("later-cleanup"))
+    )
+
+    assert isinstance(cleanup_error, RuntimeError)
+    assert "later-cleanup" in events
+    assert events.index("terminate") < events.index("kill")
+    assert "control-close" not in events and "process-close" not in events
+    assert any(item[1] is process and control in item[2] for item in _RETAINED_ARB05_CHILDREN)
+
+    # Once a later observer can confirm exit, it may close the retained handles.
+    process.alive = False
+    process.exitcode = -9
+    assert _close_confirmed_child_handles("fake delayed exit", process, (control,)) is None
+    assert control.closed and process.closed
+    assert all(item[1] is not process for item in _RETAINED_ARB05_CHILDREN)
+
