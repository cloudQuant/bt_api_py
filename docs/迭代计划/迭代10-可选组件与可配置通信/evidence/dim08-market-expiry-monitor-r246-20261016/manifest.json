  "dim08_clause_assessment": [
    {
      "clause": "expiry/roll subscriptions",
      "status": "PASS_LOCAL_SYNTHETIC",
      "evidence": "R11 starts old and new full MarketSubscriptionKey concurrently, observes both active, then releases old and verifies new remains subscribed."
    },
    {
      "clause": "old position remains assigned to original full contract key",
      "status": "PASS_LOCAL_SYNTHETIC",
      "evidence": "AccountObservation refresh after new quote still contains exactly one quantity-2 position with _OLD_INSTRUMENT and not _NEW_INSTRUMENT."
    },
    {
      "clause": "producer/outbox/consumer recovery",
      "status": "PASS_LOCAL_SERVICEHOST_SYNTHETIC_PROVIDER",
      "evidence": "R11 uses spawned real ServiceHost/CURVE clients, real Gateway hub/relay and SQLite Monitor outbox; same event replay is idempotent; a restarted threshold loop resumes the durable scope checkpoint."
    },
    {
      "clause": "threshold configuration, windows and multiple dimensions",
      "status": "PARTIAL",
      "evidence": "ThresholdRule is bounded and binds exact outbox_scope + event_type; R2 unit tests validate window re-arm/replay; R11 uses a 60-second/two-event rule and proves wrong scope and wrong event type do not count. Strategy/account/instrument/product/group threshold dimensions and combined-dimension coverage are not established. The current rule window uses the consumer processing clock, not the source event timestamp."
    },
    {
      "clause": "duplicate-event behavior",
      "status": "PARTIAL_AT_LEAST_ONCE_DISCLOSURE",
      "evidence": "Same source_event_id replay shares sequence and does not add a row; sequence watermark and acked durable checkpoint prevent ordinary replay double count. R2 explicitly demonstrates that lost ACK at a crossing may re-alert at a different event, and sink failure at crossing followed by restart may not re-emit; rule-window state is in-memory rather than durable."
    },
    {
      "clause": "authorization/permission boundaries",
      "status": "PARTIAL_LOCAL",
      "evidence": "R11 account-scoped relay registration fails with SCOPE_DENIED before any provider start or outbox row; system-scoped market read and telemetry append are granted. Full monitor read/ack/control-role matrix is not exercised."
    },
    {
      "clause": "tag/cardinality capacity",
      "status": "NOT_ESTABLISHED",
      "evidence": "R11 sets bounded pending-event/byte and ingress max-event/count/byte limits, but these are queue/payload limits and do not test metric-label/tag cardinality capacity."
    },
    {
      "clause": "alerting does not act as hard risk/admission control",
      "status": "PASS_NARROW_ADVISORY_PATH",
      "evidence": "R11 route only reads market and appends telemetry; threshold component is read-only with respect to producer outbox and imports/calls no Risk/admission route in the accepted R2 source evidence."
    }
