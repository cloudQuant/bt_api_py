+def _read_risk_legs(
+    account_paths: dict[str, dict[str, str]], group_id: str, deadline_ns: int
+) -> dict[str, tuple[Any, ...]]:
+    facts: dict[str, tuple[Any, ...]] = {}
+    for account_ref in arb02._ACCOUNTS:
+        gate = arb02.DurableRiskGate(
+            account_paths[account_ref]["risk_gate"], arb02._risk_policy()
+        )
+        try:
+            receipt = gate.read_group_vector_snapshot(
+                arb02.AccountScope("fixture", f"provider-{account_ref}", "simulation"),
+                group_id,
+            )
+            assert receipt.deadline_ns == deadline_ns
+            assert len(receipt.legs) == 1
+            leg = receipt.legs[0]
+            facts[account_ref] = (leg.state.value, leg.claimed, leg.resolved)
+        finally:
+            gate.close()
+    return facts
+
