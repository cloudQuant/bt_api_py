+def _coordinator_host_process_with_recovery_barriers(
+    control: Any,
+    raw_config: dict[str, Any],
+    raw_account_configs: dict[str, dict[str, Any]],
+    registry_path: str,
+    group_store_path: str,
+    run_bindings_path: str,
+    account_endpoints: dict[str, str],
+    account_server_public: dict[str, bytes],
+    coordinator_server_public: bytes,
+    coordinator_server_secret: bytes,
+    coordinator_client_public: bytes,
+    coordinator_client_secret: bytes,
+    strategy_client_public: dict[str, bytes],
+    strategy_client_secret: dict[str, bytes],
+    metadata_reference_ns: int,
+    startup_recovery_release: Any,
+    freeze_owner_recovery: Any,
+) -> None:
+    """Use the real coordinator Host with a barrier before startup recovery."""
+
+    original_maintain_components = arb02.ServiceHost._maintain_components
+    original_maintain_registrations = GroupCoordinatorService.maintain_registrations
+    original_runtime_call = arb02.ServiceClientRuntime.call
+    startup_barrier_used = False
+    freeze_reported = False
+
+    def registration_summary(runtime: Any) -> tuple[Any, ...]:
+        return tuple(
+            (
+                item.mount,
+                item.scope.account_ref,
+                item.scope.strategy_ref,
+                item.scope_ref,
+                item.registration_id,
+                tuple(sorted(item.operations)),
+            )
+            for item in runtime.bindings
+            if item.active
+        )
+
+    def request_id(mount: str, operation: str, arguments: Any) -> str | None:
+        if not isinstance(arguments, dict):
+            return None
+        candidate = arguments.get("intent_id")
+        intent = arguments.get("intent")
+        if candidate is None and isinstance(intent, dict):
+            candidate = intent.get("intent_id")
+        if candidate is None:
+            candidate = arguments.get("group_id")
+        return candidate if type(candidate) is str else None
+
+    def traced_call(runtime: Any, mount: str, operation: str, arguments: Any, *args: Any, **kwargs: Any):
+        if operation not in {
+            "reservations.query",
+            "orders.query_group_leg",
+            "orders.submit_group_leg",
+        }:
+            return original_runtime_call(runtime, mount, operation, arguments, *args, **kwargs)
+        account_ref = kwargs.get("account_ref")
+        scope_ref = kwargs.get("scope_ref")
+        business_id = request_id(mount, operation, arguments)
+        matches = tuple(
+            binding
+            for binding in runtime.bindings
+            if binding.active
+            and binding.mount == mount
+            and operation in binding.operations
+            and (account_ref is None or binding.scope.account_ref == account_ref)
+            and (scope_ref is None or binding.scope_ref == scope_ref)
+        )
+        registration_id = matches[0].registration_id if len(matches) == 1 else None
+        facts = (mount, operation, account_ref, scope_ref, business_id, registration_id)
+        control.send(("rpc", "start", *facts))
+        try:
+            reply = original_runtime_call(runtime, mount, operation, arguments, *args, **kwargs)
+        except BaseException as error:
+            control.send(
+                (
+                    "rpc",
+                    "error",
+                    *facts,
+                    type(error).__name__,
+                    getattr(error, "code", None),
+                )
+            )
+            raise
+        result = reply.get("result") if hasattr(reply, "get") else None
+        control.send(
+            (
+                "rpc",
+                "reply",
+                *facts,
+                reply.get("ok") if hasattr(reply, "get") else None,
+                reply.get("code") if hasattr(reply, "get") else None,
+                result is None,
+            )
+        )
+        return reply
+
+    def gated_maintain_components(
+        host: Any, *, registrations_only: bool = False
+    ) -> None:
+        nonlocal startup_barrier_used
+        if registrations_only and not startup_barrier_used:
+            upstream = host.upstream
+            if upstream is None or not upstream.healthy:
+                raise AssertionError("coordinator upstream bindings are not ready at barrier")
+            control.send(("recovery_barrier", registration_summary(upstream)))
+            if not startup_recovery_release.wait(60):
+                raise TimeoutError("startup recovery barrier was not released")
+            startup_barrier_used = True
+        original_maintain_components(host, registrations_only=registrations_only)
+
+    def bounded_maintain_registrations(
+        service: Any, contexts: tuple[Any, ...], *, recover: bool = True
+    ) -> None:
+        nonlocal freeze_reported
+        if freeze_owner_recovery.is_set() and recover:
+            if not freeze_reported:
+                control.send(("recovery_frozen",))
+                freeze_reported = True
+            return
+        original_maintain_registrations(service, contexts, recover=recover)
+
+    arb02.ServiceHost._maintain_components = gated_maintain_components
+    GroupCoordinatorService.maintain_registrations = bounded_maintain_registrations
+    arb02.ServiceClientRuntime.call = traced_call
+    try:
+        arb02._coordinator_host_process(
+            control,
+            raw_config,
+            raw_account_configs,
+            registry_path,
+            group_store_path,
+            run_bindings_path,
+            account_endpoints,
+            account_server_public,
+            coordinator_server_public,
+            coordinator_server_secret,
+            coordinator_client_public,
+            coordinator_client_secret,
+            strategy_client_public,
+            strategy_client_secret,
+            metadata_reference_ns,
+        )
+    finally:
+        arb02.ServiceHost._maintain_components = original_maintain_components
+        GroupCoordinatorService.maintain_registrations = original_maintain_registrations
+        arb02.ServiceClientRuntime.call = original_runtime_call
+
