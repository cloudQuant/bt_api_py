+def _start_coordinator_at_recovery_barrier(
+    context: Any,
+    account_configs: dict[str, dict[str, Any]],
+    paths: dict[str, str],
+    account_endpoints: dict[str, str],
+    account_server_public: dict[str, bytes],
+    coordinator_keys: tuple[bytes, bytes],
+    coordinator_client_keys: tuple[bytes, bytes],
+    strategy_keys: dict[str, tuple[bytes, bytes]],
+    metadata_reference_ns: int,
+) -> tuple[Any, Any, str, tuple[Any, ...], Any, Any, list[tuple[Any, ...]]]:
+    endpoint = arb02._endpoint()
+    raw_config = arb02._coordinator_service_config(endpoint, account_configs, account_endpoints)
+    parent_control, child_control = context.Pipe(duplex=True)
+    startup_recovery_release = context.Event()
+    freeze_owner_recovery = context.Event()
+    server_public, server_secret = coordinator_keys
+    client_public, client_secret = coordinator_client_keys
+    process = None
+    process_started = False
+    child_control_open = True
+    observed: list[tuple[Any, ...]] = []
+    messages_seen = 0
+    try:
+        process = context.Process(
+            name="arb05-group-coordinator-recovery-barrier",
+            target=_coordinator_host_process_with_recovery_barriers,
+            args=(
+                child_control,
+                raw_config,
+                account_configs,
+                paths["registry"],
+                paths["groups"],
+                paths["run_bindings"],
+                account_endpoints,
+                account_server_public,
+                server_public,
+                server_secret,
+                client_public,
+                client_secret,
+                {strategy: strategy_keys[strategy][0] for strategy in arb02._STRATEGIES},
+                {strategy: strategy_keys[strategy][1] for strategy in arb02._STRATEGIES},
+                metadata_reference_ns,
+                startup_recovery_release,
+                freeze_owner_recovery,
+            ),
+        )
+        process.start()
+        process_started = True
+        child_control.close()
+        child_control_open = False
+        deadline = time.monotonic() + 30
+        while True:
+            message = _receive_coordinator_control(
+                parent_control, process, deadline, "startup recovery barrier"
+            )
+            if message is None:
+                continue
+            messages_seen += 1
+            if messages_seen > _MAX_COORDINATOR_CONTROL_MESSAGES_PER_PHASE:
+                raise AssertionError("coordinator startup message budget exceeded")
+            if message[0] == "rpc":
+                observed.append(message)
+                continue
+            if message[0] == "error":
+                raise AssertionError(
+                    f"coordinator startup failed: {message!r}; observed={observed!r}"
+                )
+            assert message[0] == "recovery_barrier", message
+            bindings = message[1]
+            _validate_coordinator_bindings(bindings)
+            return (
+                process,
+                parent_control,
+                endpoint,
+                bindings,
+                startup_recovery_release,
+                freeze_owner_recovery,
+                observed,
+            )
+    except BaseException as startup_error:
+        cleanup_error = _cleanup_failed_coordinator_barrier_start(
+            process,
+            parent_control,
+            child_control,
+            startup_recovery_release,
+            freeze_owner_recovery,
+            process_started=process_started,
+            child_control_open=child_control_open,
+            observed=observed,
+        )
+        if cleanup_error is not None:
+            add_note = getattr(startup_error, "add_note", None)
+            if callable(add_note):
+                add_note(f"coordinator barrier cleanup failed: {type(cleanup_error).__name__}")
+        raise
+
+
+def _wait_coordinator_message(
+    control: Any,
+    process: Any,
+    observed: list[tuple[Any, ...]],
+    expected_kind: str,
+    *,
+    timeout: float = 30,
+) -> tuple[Any, ...]:
+    deadline = time.monotonic() + timeout
+    messages_seen = 0
+    while True:
+        message = _receive_coordinator_control(
+            control, process, deadline, f"message {expected_kind!r}"
+        )
+        if message is None:
+            continue
+        messages_seen += 1
+        if messages_seen > _MAX_COORDINATOR_CONTROL_MESSAGES_PER_PHASE:
+            raise AssertionError(
+                f"coordinator message budget exceeded while waiting for {expected_kind!r}"
+            )
+        if message[0] == "rpc":
+            observed.append(message)
+            continue
+        if message[0] == "error":
+            raise AssertionError(f"coordinator failed: {message!r}")
+        if message[0] == expected_kind:
+            return message
+        raise AssertionError(f"unexpected coordinator control message: {message!r}")
+
+
+def _wait_for_rpc(
+    control: Any,
+    process: Any,
+    observed: list[tuple[Any, ...]],
+    predicate: Any,
+    *,
+    timeout: float = 20,
+) -> tuple[Any, ...]:
+    deadline = time.monotonic() + timeout
+    messages_seen = 0
+    while True:
+        for message in observed:
+            if predicate(message):
+                return message
+        message = _receive_coordinator_control(
+            control, process, deadline, "the expected upstream RPC"
+        )
+        if message is None:
+            continue
+        messages_seen += 1
+        if messages_seen > _MAX_COORDINATOR_CONTROL_MESSAGES_PER_PHASE:
+            raise AssertionError("coordinator RPC message budget exceeded")
+        if message[0] == "rpc":
+            observed.append(message)
+            if predicate(message):
+                return message
+        elif message[0] == "error":
+            raise AssertionError(f"coordinator failed while tracing RPCs: {message!r}")
+        else:
+            observed.append(message)
+
