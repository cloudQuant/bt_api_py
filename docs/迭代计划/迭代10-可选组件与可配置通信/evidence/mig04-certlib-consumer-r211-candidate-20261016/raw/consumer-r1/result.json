        "\nimport hashlib, importlib.metadata as md, json, re, site, sys\nfrom pathlib import Path\nimport certlib\nfrom certlib import binance_client, context, envfile, monitor, runner, validation\nimport yaml\nexpected = json.loads(sys.argv[1])\nexpected_env = Path(sys.argv[2]).resolve()\nroots = [Path(value).resolve() for value in site.getsitepackages()]\nmodules = {\"certlib\": certlib, \"certlib.binance_client\": binance_client,\n    \"certlib.context\": context, \"certlib.envfile\": envfile,\n    \"certlib.monitor\": monitor, \"certlib.runner\": runner,\n    \"certlib.validation\": validation, \"yaml\": yaml}\norigins = {}\nfor name, module in modules.items():\n    path = Path(module.__file__).resolve()\n    assert any(path.is_relative_to(root) for root in roots), (name, str(path))\n    origins[name] = str(path)\nsource_hashes = {}\nfor name, module in modules.items():\n    if name == \"yaml\":\n        continue\n    filename = \"__init__.py\" if name == \"certlib\" else name.split(\".\", 1)[1] + \".py\"\n    digest = hashlib.sha256(Path(module.__file__).read_bytes()).hexdigest()\n    assert digest == expected[filename], (filename, digest)\n    source_hashes[filename] = digest\nnormalize = lambda value: re.sub(r\"[-_.]+\", \"-\", value).lower()\ndist = \"bt-api-binance-certlib\"\nowners = md.packages_distributions().get(\"certlib\", [])\nassert md.version(dist) == \"0.1.0\"\nassert [normalize(item) for item in owners] == [normalize(dist)], owners\nassert md.version(\"PyYAML\") == \"6.0.3\"\nassert envfile.default_env_path().resolve() == expected_env\nassert not expected_env.exists()\nprint(json.dumps({\"distribution\": dist, \"version\": md.version(dist),\n    \"owners\": owners, \"origins\": origins, \"source_hashes\": source_hashes,\n    \"site_roots\": [str(path) for path in roots], \"PyYAML\": md.version(\"PyYAML\"),\n    \"default_env_path\": str(expected_env), \"default_env_exists\": expected_env.exists()},\n    sort_keys=True))\n",
