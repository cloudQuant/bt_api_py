+def _group_attempt_payload(path: str, intent_id: str) -> dict[str, Any]:
+    """Read the durable dispatch identity that joins business and provider IDs."""
+
+    database_uri = f"file:{Path(path).as_posix()}?mode=ro"
+    with sqlite3.connect(database_uri, uri=True) as connection:
+        rows = connection.execute(
+            "SELECT group_id, leg_id, payload_json FROM group_proof_events "
+            "WHERE intent_id=? AND event_type='ATTEMPT_STARTED' ORDER BY revision",
+            (intent_id,),
+        ).fetchall()
+    assert len(rows) == 1, (intent_id, len(rows))
+    group_id, leg_id, payload_json = rows[0]
+    payload = json.loads(payload_json)
+    provider_request = payload.get("provider_request")
+    client_order_id = payload.get("client_order_id")
+    assert payload.get("intent_id") == intent_id
+    assert payload.get("group_id") == group_id
+    assert payload.get("leg_id") == leg_id
+    assert type(client_order_id) is str and client_order_id
+    assert isinstance(provider_request, dict)
+    assert provider_request.get("client_order_id") == client_order_id
+    assert provider_request.get("idempotency_key") == client_order_id
+    return payload
+
